# Dependencies
node_modules/

# Vite build output
dist/
dist-ssr/
*.local

# TypeScript / build cache
*.tsbuildinfo

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Capacitor — Android build artifacts (NOT the project files)
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/captures/
android/local.properties
android/keystore.properties
android/app/release/
android/app/debug/
android/capacitor-cordova-android-plugins/build/
android/capacitor-cordova-android-plugins/.gradle/
android/*.iml
android/app/*.iml

# Capacitor — iOS (if added later)
ios/App/build/
ios/App/Pods/
ios/App/output/
ios/DerivedData/
ios/App/.gradle/

# Generated by capacitor-assets
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/assets/public/

# Personal data — Excel time-trackers and import/export JSONs
*.xlsx
*.xlsm
~$*.xls*
timesheet-import.json
*-backup-*.json

# APK output
*.apk
*.aab

# Env
.env
.env.local
.env.*.local

# Signing keys — never commit. The release keystore itself lives outside the
# repo (see README), but guard against a stray copy being added here.
*.jks
*.keystore
**/keystore.properties