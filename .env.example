# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard -> Project Settings -> API).
#
# The anon key is safe to ship in the client bundle — Row-Level Security in
# supabase/schema.sql is the security boundary, not key secrecy. Never put the
# `service_role` key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
