# STAGING Supabase project — copy to `.env.staging.local` (gitignored) and fill
# in from the staging project's Dashboard -> Project Settings -> API.
#
# Used only by `npm run dev:staging`, `build:staging`, `android:sync:staging`.
# Production builds keep using `.env`.

# Required. A staging build refuses to start without it, so a missing file
# can never silently fall back to the production values in `.env`.
VITE_ENV_NAME=staging

VITE_SUPABASE_URL=https://your-staging-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-public-key
